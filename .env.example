# Copy this file to .env and fill in your own Supabase project's values.
# Get both from: Supabase Dashboard → your project → Settings → API
#
# VITE_SUPABASE_URL      -> "Project URL"
# VITE_SUPABASE_ANON_KEY -> "anon" "public" key (NOT the service_role key)
#
# Never commit .env, and never put the service_role key in frontend code —
# it bypasses Row Level Security entirely.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
